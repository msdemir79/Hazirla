<Window x:Class="Hazirla.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hazırla" Width="820" Height="620" MinWidth="760" MinHeight="580" WindowStartupLocation="CenterScreen" Background="#F3F5F8" Foreground="#17243B" FontFamily="Segoe UI" FontSize="13" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Icon="Assets/Hazirla.ico">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#EDF1F7"/><Setter Property="Foreground" Value="#243652"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#4269DC"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#DCE2EC"/><Setter Property="Background" Value="White"/></Style>
<Style TargetType="ComboBox"><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,4"/></Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/><Setter Property="BorderBrush" Value="#E3E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
</Window.Resources>
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,14"><StackPanel><TextBlock Text="Hazırla" FontSize="24" FontWeight="Bold"/><TextBlock Text="" Foreground="#65738A" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E4F2EC" CornerRadius="14" Padding="12,6"><TextBlock Text="●  Bilgisayarında işlenir" Foreground="#226448" FontSize="12"/></Border></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><TextBlock Text="Görseller" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="FileCount" Text="0 dosya" HorizontalAlignment="Right" Foreground="#65738A" VerticalAlignment="Center"/></Grid>
<StackPanel x:Name="FileTools" Grid.Row="1" Margin="0,10,0,8"><Button Content="＋  Görsel seç" Click="OnAdd" HorizontalAlignment="Left" Background="#E7EDFF" Foreground="#3154B2" ToolTip="JPG, PNG veya WebP dosyalarını seç"/><TextBlock Text="veya dosyaları bu pencereye sürükle" Foreground="#65738A" FontSize="12" Margin="0,8,0,0"/></StackPanel>
<Grid Grid.Row="2"><ListBox x:Name="Files" SelectionMode="Single" SelectionChanged="OnSelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Border Padding="8,5" BorderBrush="#EDF0F5" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" FontSize="12" Foreground="#65738A" Margin="0,1,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyHint" IsHitTestVisible="False" Text="Henüz görsel eklenmedi.&#x0a;JPG · PNG · WebP" TextAlignment="Center" Foreground="#7C899D" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
<WrapPanel x:Name="OrderTools" Grid.Row="3" Margin="0,14,0,0"><Button x:Name="RemoveButton" Content="Kaldır" Click="OnRemove"/><Button Content="↑" Click="OnUp" ToolTip="PDF sıralamasında yukarı taşı" AutomationProperties.Name="Yukarı taşı"/><Button Content="↓" Click="OnDown" ToolTip="PDF sıralamasında aşağı taşı" AutomationProperties.Name="Aşağı taşı"/></WrapPanel>
</Grid></Border>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel"><TextBlock Text="İşlem ayarları" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/><Label Target="{Binding ElementName=Mode}" Content="İşlem" Padding="0,0,0,4"/><ComboBox x:Name="Mode" SelectedIndex="0" SelectionChanged="OnModeChanged"><ComboBoxItem Content="Hedef boyuta küçült"/><ComboBoxItem Content="Biçim dönüştür"/><ComboBoxItem Content="Tek PDF oluştur"/></ComboBox>
<StackPanel x:Name="FormatPanel" Margin="0,8,0,0"><Label Target="{Binding ElementName=Format}" Content="Çıktı biçimi" Padding="0,0,0,4"/><ComboBox x:Name="Format" SelectedIndex="0"><ComboBoxItem Content="JPG"/><ComboBoxItem Content="PNG"/><ComboBoxItem Content="WebP"/></ComboBox></StackPanel>
<StackPanel x:Name="TargetPanel" Margin="0,8,0,0"><Label Target="{Binding ElementName=Target}" Content="Üst sınır / dosya" Padding="0,0,0,4"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="MB" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBox x:Name="Target" Text="2"/></DockPanel></StackPanel>
<Border Background="#F3F6FC" CornerRadius="8" Padding="8" Margin="0,8,0,0"><TextBlock x:Name="ModeHint" Text="Boyut için kalite ve gerekirse çözünürlük azaltılır." TextWrapping="Wrap" Foreground="#596B85" FontSize="12"/></Border>
</StackPanel></ScrollViewer></Border></Grid>
<Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Status" Text="Başlamak için görsel ekle." Foreground="#65738A" TextWrapping="Wrap" Margin="0,0,12,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="PreviewButton" Content="Önizle" Click="OnPreview"/><Button x:Name="RunButton" Content="Hazırla" Background="#355CDD" Foreground="White" Click="OnRun"/><Button x:Name="CancelButton" Content="İptal" Click="OnCancel"/></WrapPanel></Grid>
<ProgressBar x:Name="Progress" Height="5" Margin="0,14,0,10" Foreground="#355CDD" Background="#EDF1F7" BorderThickness="0"/>
<Expander Header="Sonuçlar" x:Name="ResultsExpander"><StackPanel><TextBox x:Name="Results" IsReadOnly="True" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,6,0,0"/><WrapPanel Margin="0,6,0,0"><Button x:Name="RetryButton" Content="Başarısızları yeniden dene" Click="OnRetry"/><Button x:Name="OpenButton" Content="Klasörü aç ↗" Click="OnOpen" Background="Transparent"/></WrapPanel></StackPanel></Expander></StackPanel></Border>
</Grid></Window>




